// Prisma Schema for PORTEX (Unified Marketplace & Hyperlocal Logistics Platform)
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  DRIVER
  ADMIN
  ENTERPRISE
}

enum ListingCondition {
  BRAND_NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  EXPIRED
  ARCHIVED
}

enum DeliveryVehicleType {
  TWO_WHEELER
  THREE_WHEELER_AUTO
  TATA_ACE_MINI_TRUCK
  PICKUP_8FT
  TEMPO_CLOSED
  EICHER_14FT
  ELECTRIC_CARGO
}

enum DeliveryStatusStage {
  BOOKING_CREATED
  DRIVER_ASSIGNED
  DRIVER_ARRIVING_PICKUP
  ITEM_PICKED_UP
  IN_TRANSIT
  NEAR_DESTINATION
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String?        @unique
  fullName      String
  avatarUrl     String?
  role          UserRole       @default(BUYER)
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  profile       Profile?
  sellerProfile Seller?
  driverProfile Driver?
  listings      Listing[]
  buyerOrders   Order[]        @relation("BuyerOrders")
  sellerOrders  Order[]        @relation("SellerOrders")
  deliveries    Delivery[]     @relation("CustomerDeliveries")
  sentOffers    Offer[]        @relation("SentOffers")
  receivedOffers Offer[]       @relation("ReceivedOffers")
  favorites     Favorite[]
  addresses     Address[]
  notifications Notification[]
  reviewsGiven  Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]     @relation("ReviewsReceived")
  messagesSent  Message[]      @relation("SentMessages")
  disputesRaised Dispute[]     @relation("DisputesRaised")
  adminLogs     AdminLog[]
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  city           String?
  state          String?
  pincode        String?
  ratingAvg      Float     @default(5.0)
  totalRatings   Int       @default(0)
  businessName   String?
  gstin          String?
}

model Seller {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName      String
  badgeType      String    @default("VERIFIED_SELLER")
  responseRate   Float     @default(98.5)
  avgResponseTime String   @default("< 15 mins")
  trustScore     Int       @default(96)
  isKycVerified  Boolean   @default(true)
}

model Driver {
  id             String              @id @default(uuid())
  userId         String              @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnline       Boolean             @default(true)
  currentLat     Float               @default(26.8467)
  currentLng     Float               @default(80.9462)
  rating         Float               @default(4.9)
  totalTrips     Int                 @default(142)
  drivingLicense String?
  kycStatus      KycStatus           @default(APPROVED)
  assignedVehicle Vehicle?
  deliveries     Delivery[]          @relation("DriverDeliveries")
  payouts        Payout[]
}

model Vehicle {
  id             String              @id @default(uuid())
  driverId       String              @unique
  driver         Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type           DeliveryVehicleType
  makeModel      String
  regNumber      String              @unique
  maxPayloadKg   Int
  dimensions     String
  isVerified     Boolean             @default(true)
}

model Category {
  id             String              @id @default(uuid())
  name           String              @unique
  slug           String              @unique
  icon           String
  description    String?
  parentId       String?
  parent         Category?           @relation("SubCategories", fields: [parentId], references: [id])
  children       Category[]          @relation("SubCategories")
  listings       Listing[]
}

model Listing {
  id             String              @id @default(uuid())
  title          String
  slug           String              @unique
  description    String
  price          Decimal             @db.Decimal(12, 2)
  originalPrice  Decimal?            @db.Decimal(12, 2)
  condition      ListingCondition    @default(LIKE_NEW)
  status         ListingStatus       @default(ACTIVE)
  isFeatured     Boolean             @default(false)
  viewsCount     Int                 @default(0)
  favoritesCount Int                 @default(0)
  
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  
  sellerId       String
  seller         User                @relation(fields: [sellerId], references: [id])

  // Geolocation & Pickup Address
  pickupAddress  String
  city           String
  state          String
  pincode        String
  latitude       Float?
  longitude      Float?

  // Packaging and Delivery Specs for Integrated Porter Dispatch
  weightKg       Float?              @default(2.5)
  dimensions     String?             @default("30x20x15 cm")
  eligibleForDelivery Boolean        @default(true)

  images         ListingImage[]
  favorites      Favorite[]
  offers         Offer[]
  orders         Order[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model ListingImage {
  id             String              @id @default(uuid())
  listingId      String
  listing        Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url            String
  isPrimary      Boolean             @default(false)
  orderIndex     Int                 @default(0)
}

model Delivery {
  id                 String              @id @default(uuid())
  trackingNumber     String              @unique
  customerId         String
  customer           User                @relation("CustomerDeliveries", fields: [customerId], references: [id])
  
  driverId           String?
  driver             Driver?             @relation("DriverDeliveries", fields: [driverId], references: [id])

  vehicleType        DeliveryVehicleType
  status             DeliveryStatusStage @default(BOOKING_CREATED)

  pickupAddress      String
  pickupLat          Float
  pickupLng          Float
  pickupContactName  String
  pickupContactPhone String
  pickupOtp          String              @default("4921")

  dropAddress        String
  dropLat            Float
  dropLng            Float
  dropContactName    String
  dropContactPhone   String
  deliveryOtp        String              @default("8302")

  packageType        String
  packageWeightKg    Float
  packageDimensions  String?
  specialInstructions String?

  distanceKm         Float
  estimatedDurationMins Int
  fareAmount         Decimal             @db.Decimal(10, 2)
  gstAmount          Decimal             @db.Decimal(10, 2)
  totalFare          Decimal             @db.Decimal(10, 2)

  podImageUrl        String?
  podSignatureUrl    String?

  paymentStatus      PaymentStatus       @default(CAPTURED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Order {
  id                 String              @id @default(uuid())
  orderNumber        String              @unique
  buyerId            String
  buyer              User                @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId           String
  seller             User                @relation("SellerOrders", fields: [sellerId], references: [id])
  listingId          String
  listing            Listing             @relation(fields: [listingId], references: [id])

  productPrice       Decimal             @db.Decimal(12, 2)
  deliveryFee        Decimal             @db.Decimal(10, 2) @default(0)
  platformFee        Decimal             @db.Decimal(10, 2) @default(0)
  taxAmount          Decimal             @db.Decimal(10, 2) @default(0)
  totalAmount        Decimal             @db.Decimal(12, 2)

  paymentMethod      String              @default("ONLINE_ESCROW")
  paymentStatus      PaymentStatus       @default(CAPTURED)
  
  deliveryId         String?             @unique
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Offer {
  id             String    @id @default(uuid())
  listingId      String
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User      @relation("SentOffers", fields: [buyerId], references: [id])
  sellerId       String
  seller         User      @relation("ReceivedOffers", fields: [sellerId], references: [id])
  offeredAmount  Decimal   @db.Decimal(12, 2)
  counterAmount  Decimal?  @db.Decimal(12, 2)
  status         String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, COUNTERED
  message        String?
  createdAt      DateTime  @default(now())
}

model Conversation {
  id             String    @id @default(uuid())
  participant1Id String
  participant2Id String
  listingId      String?
  deliveryId     String?
  lastMessage    String?
  updatedAt      DateTime  @updatedAt
  messages       Message[]
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  imageUrl       String?
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag        String   @default("Home") // Home, Work, Warehouse
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)
}

model Review {
  id           String   @id @default(uuid())
  authorId     String
  author       User     @relation("ReviewsGiven", fields: [authorId], references: [id])
  targetUserId String
  targetUser   User     @relation("ReviewsReceived", fields: [targetUserId], references: [id])
  rating       Int      @default(5)
  comment      String
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // ORDER, DELIVERY, OFFER, CHAT, SYSTEM
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payout {
  id          String   @id @default(uuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  bankAccount String
  status      String   @default("COMPLETED")
  referenceId String   @unique
  createdAt   DateTime @default(now())
}

model Dispute {
  id          String        @id @default(uuid())
  raisedById  String
  raisedBy    User          @relation("DisputesRaised", fields: [raisedById], references: [id])
  orderId     String?
  deliveryId  String?
  title       String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime      @default(now())
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  module     String
  details    String
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model BusinessProfileConfig {
  id                 String   @id @default(uuid())
  legalName          String   @default("MANGO TECH ENTERPRISES")
  tradeName          String   @default("M/S MANGO TECH ENTERPRISES")
  gstin              String   @default("09ABRFM9138P1Z3")
  constitution       String   @default("Partnership")
  principalAddress   String   @default("E-3/776, SECTOR-I ALIGANJ, LUCKNOW, Lucknow, Uttar Pradesh, 226024")
  jurisdiction       String   @default("Lucknow Sector-14")
  dateOfIssue        String   @default("10/10/2021")
  platformFeePercent Float    @default(2.5)
  deliveryCommission Float    @default(15.0)
  taxRatePercent     Float    @default(18.0)
  updatedAt          DateTime @updatedAt
}
